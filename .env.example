APP_ENV=development
DATABASE_URL=postgresql+psycopg://storyaudit:storyaudit@localhost:5432/storyaudit
APP_ACCESS_TOKEN=local-test-token
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=mock-v1
LLM_API_KEY=
# Stage routing (empty = LLM_MODEL). Volume stages A1-A4 go to FAST,
# synthesis/narrative stages go to SMART.
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_FAST_AGENTS=A1,A2,A3,A4
LLM_SCHEMA_REPAIR_ATTEMPTS=2
LLM_TRANSPORT_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=90
# USD per 1M tokens; used only for the cost estimate in GET /scans/{id}/usage.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
# Propositions per provider call for A2/A3/A4 (1 = one call per proposition).
ANNOTATION_BATCH_SIZE=20
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=2097152
WEBSITE_MAX_PAGES=5
WEBSITE_FETCH_TIMEOUT_SECONDS=15
WEBSITE_ALLOW_PRIVATE_HOSTS=false
REPORT_LIVE_CHECK=true
REPORT_LIVE_CHECK_TIMEOUT_SECONDS=3
REPORT_MAX_STATEMENTS=25
REPORT_MAX_PRODUCTS=10
WEBSITE_FETCH_DELAY_SECONDS=0
WEBSITE_RESPECT_ROBOTS=true
LANDSCAPE_MAX_COMPETITORS=5
LANDSCAPE_MAX_PAGES=3
LANDSCAPE_FETCH_DELAY_SECONDS=0.5
