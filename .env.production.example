# Production settings for running on this PC behind a Cloudflare Tunnel.
# Copy to .env.production (gitignored), fill the secrets, and start with
# scripts/start-public.ps1. Do not expose port 8000 directly.

APP_ENV=production
DATABASE_URL=postgresql+psycopg://storyaudit:storyaudit@127.0.0.1:5432/storyaudit
APP_ACCESS_TOKEN=CHANGE_ME_APP_ACCESS_TOKEN
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=2097152

# Public origin as clients see it. Must be the final HTTPS domain, not
# trycloudflare.com: capability links already sent to clients depend on it.
PUBLIC_BASE_URL=https://audit.example.com
PUBLIC_HASH_SALT=CHANGE_ME_RANDOM_SALT
PUBLIC_REQUESTS_PER_DAY=20
PUBLIC_REQUESTS_PER_IP_PER_DAY=3
PUBLIC_REQUEST_TOKEN_TTL_DAYS=30
PUBLIC_CONSENT_VERSION=2026-11-14

# Real provider. Copy these five lines from the local .env (it is gitignored).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=CHANGE_ME
LLM_API_KEY=CHANGE_ME
LLM_MODEL=CHANGE_ME
LLM_MODEL_FAST=CHANGE_ME
LLM_MODEL_SMART=CHANGE_ME
# JSON object string, exactly as in .env. Required by the opencode.ai gateway.
LLM_EXTRA_HEADERS={"User-Agent":"...","x-opencode-client":"...","x-opencode-session":"..."}
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
LLM_FAST_AGENTS=A1,A2,A3,A4
LLM_SCHEMA_REPAIR_ATTEMPTS=2
LLM_TRANSPORT_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=90

# Ingestion and report behaviour.
WEBSITE_MAX_PAGES=5
WEBSITE_FETCH_TIMEOUT_SECONDS=15
WEBSITE_FETCH_DELAY_SECONDS=0.5
WEBSITE_RESPECT_ROBOTS=true
# MUST stay false on a public server: otherwise the crawler can reach the LAN.
WEBSITE_ALLOW_PRIVATE_HOSTS=false
LANDSCAPE_MAX_COMPETITORS=5
LANDSCAPE_MAX_PAGES=3
LANDSCAPE_FETCH_DELAY_SECONDS=0.5
REPORT_LIVE_CHECK=true
REPORT_LIVE_CHECK_TIMEOUT_SECONDS=3
REPORT_MAX_STATEMENTS=25
REPORT_MAX_PRODUCTS=10
REPORT_PDF_TIMEOUT_SECONDS=60
ANNOTATION_BATCH_SIZE=20

# Queue, limits and disk hygiene.
JOB_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=300
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCANS_PER_DAY=100
RATE_LIMIT_SOURCES_PER_HOUR=12
RATE_LIMIT_RUNS_PER_HOUR=10
RATE_LIMIT_REANALYSIS_PER_HOUR=20
RATE_LIMIT_REPORT_BUILDS_PER_HOUR=10
RATE_LIMIT_REPORT_PDFS_PER_HOUR=30
RETENTION_ENABLED=true
RETENTION_INTERVAL_SECONDS=86400
RETENTION_REPORT_ARTIFACTS_DAYS=90
RETENTION_REPORT_ARTIFACTS_KEEP=3
RETENTION_LLM_USAGE_DAYS=180
RETENTION_ANNOTATIONS_DAYS=90
